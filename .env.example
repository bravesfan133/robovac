# Copy to .env and edit. Compose reads this file automatically.

# Address of the Valetudo webserver on your LAN, after rooting.
#
# Prefer a hostname over an IP: a DHCP lease can move, and the vacuum's address
# is not something you want to hardcode. Three options, best first:
#
#   1. mDNS, no configuration at all. Valetudo advertises itself as
#      valetudo-<robot-id>.local, e.g. valetudo-dreame_vacuum_r2492b.local
#      Confirm the exact name in Valetudo's own log output.
#      VALETUDO_URL=http://valetudo-dreame_vacuum_r2492b.local
#
#   2. A DHCP reservation plus a DNS record on your router, e.g. "vacuum".
#      Most reliable: no multicast involved, so it cannot be defeated by a
#      Wi-Fi AP or VLAN that blocks mDNS.
#      VALETUDO_URL=http://vacuum
#
#   3. A Tailscale name, if you install Tailscale on the vacuum itself.
#      VALETUDO_URL=http://vacuum.your-tailnet.ts.net
#
# An IP works too, it is just the most brittle option.
VALETUDO_URL=http://valetudo-dreame_vacuum_r2492b.local

# Valetudo's basic auth, if you enabled webserver.basicAuth.enabled.
VALETUDO_USERNAME=
VALETUDO_PASSWORD=

# Optional extra auth in front of the robovac UI itself.
WEB_USERNAME=
WEB_PASSWORD=

# Where the UI listens. With network_mode: host this must be a host address.
BIND=0.0.0.0:8080

RUST_LOG=info,robovac=debug
POLL_INTERVAL_MS=2000

# Only needed for the optional MQTT overlay (docker-compose.mqtt.yml), which
# robovac itself does not use. Leave blank unless you are adding maploader or
# Home Assistant autodiscovery.
# MOSQUITTO_HOST=192.0.2.1
# MOSQUITTO_PORT=1883
