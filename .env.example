# Copy to .env and edit. Compose reads this file automatically.

# Address of the Valetudo webserver on your LAN. After rooting, this is the
# vacuum's own IP. Use the Tailscale name if you prefer.
VALETUDO_URL=http://192.0.2.46

# Valetudo's basic auth, if you enabled webserver.basicAuth.enabled.
VALETUDO_USERNAME=
VALETUDO_PASSWORD=

# Optional extra auth in front of the robovac UI itself.
WEB_USERNAME=
WEB_PASSWORD=

# Where the UI listens. With network_mode: host this must be a host address.
BIND=0.0.0.0:8080

# Address mosquitto publishes on, so the vacuum can reach the broker.
# Use your host's LAN IP, not 127.0.0.1.
MOSQUITTO_BIND=192.0.2.1:1883

RUST_LOG=info,robovac=debug
POLL_INTERVAL_MS=2000
